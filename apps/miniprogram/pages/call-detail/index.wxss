.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.field {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.field:last-child {
  border-bottom: 0;
}

.field text:last-child {
  max-width: 430rpx;
  text-align: right;
  word-break: break-all;
}

.action-row {
  margin-top: 20rpx;
}

.action-button {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-size: 25rpx;
}

.callback-button {
  margin-top: 20rpx;
  width: 100%;
}

.audit-item {
  padding: 16rpx 0 0;
}

.audit-main {
  color: #17201c;
  font-weight: 600;
  word-break: break-all;
}

.audit-meta {
  margin-top: 6rpx;
  color: #8a929e;
  font-size: 23rpx;
}
