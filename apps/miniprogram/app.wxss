page {
  background: #f6f7f8;
  color: #17201c;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.header {
  padding: 12rpx 0 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 10rpx;
  color: #6b7280;
  line-height: 1.5;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e4e7eb;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.label {
  color: #6b7280;
  font-size: 24rpx;
}

.value {
  color: #17201c;
  font-weight: 600;
}

.badge {
  min-width: 112rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  background: #e8f4ef;
  color: #1f6f5b;
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.badge.high,
.badge.urgent {
  background: #fff1e7;
  color: #bd4b12;
}

.badge.low {
  background: #eef0f3;
  color: #6b7280;
}

.body-text {
  margin-top: 12rpx;
  line-height: 1.55;
  color: #25302b;
}

.meta {
  margin-top: 16rpx;
  color: #8a929e;
  font-size: 23rpx;
}

.empty {
  padding: 80rpx 24rpx;
  color: #8a929e;
  text-align: center;
}

.error-card {
  padding: 36rpx 28rpx;
  border: 1rpx solid #f0c7b6;
  border-radius: 8rpx;
  background: #fff7f2;
  color: #7a2f12;
  box-sizing: border-box;
}

.error-title {
  font-weight: 700;
}

.error-message {
  margin-top: 10rpx;
  color: #9a4a24;
  line-height: 1.5;
}

.error-action {
  margin-top: 20rpx;
}

.button {
  height: 76rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #1f6f5b;
  color: #ffffff;
  font-weight: 700;
  box-sizing: border-box;
}

.button::after {
  border: 0;
}

.button.secondary {
  background: #eef0f3;
  color: #25302b;
}

.input {
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8dde3;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}
