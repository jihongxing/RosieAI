ROSIE_HOST=0.0.0.0
ROSIE_PORT=8000
ROSIE_DB_PATH=./data/rosie_mvp.sqlite3
ROSIE_DEFAULT_ACCESS_NUMBER=+8617000000000
ROSIE_DEFAULT_MERCHANT_ID=demo-merchant
ROSIE_DEFAULT_MERCHANT_NAME=测试商家
ROSIE_DEFAULT_TRANSFER_PHONE=
ROSIE_PUBLIC_BASE_URL=
ROSIE_WECOM_WEBHOOK_URL=

# Optional Phase 2 integration. Use http://ai-agent:8010 when both services
# run in the same Docker network, or http://127.0.0.1:8010 for host testing.
ROSIE_USE_AI_GREETING=false
ROSIE_AI_AGENT_URL=http://127.0.0.1:8010
ROSIE_AI_TIMEOUT_SECONDS=10
