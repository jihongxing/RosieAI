ROSIE_AI_HOST=0.0.0.0
ROSIE_AI_PORT=8010

# ollama | openai_compatible | deepseek
ROSIE_LLM_PROVIDER=openai_compatible

# Ollama provider
ROSIE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI-compatible provider. DeepSeek uses this endpoint.
ROSIE_OPENAI_BASE_URL=https://api.deepseek.com
ROSIE_OPENAI_API_KEY=

ROSIE_LLM_MODEL=deepseek-chat
ROSIE_LLM_TIMEOUT_SECONDS=60
